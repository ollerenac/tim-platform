# ── OpenCTI ──────────────────────────────────────
# Normally leave these defaults unchanged. Recovery operations can select a
# separately validated Elasticsearch volume without overwriting the original.
ESDATA_VOLUME_NAME=
ESDATA_VOLUME_EXTERNAL=false

OPENCTI_BASE_URL=http://localhost:8080
OPENCTI_ADMIN_EMAIL=admin@tim.local
OPENCTI_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
OPENCTI_ADMIN_TOKEN=REPLACE_WITH_UUID

# ── Redis operational knobs ──────────────────────
# Keep REDIS_MAXMEMORY below REDIS_MEM_LIMIT for allocator and transient headroom.
# Use noeviction if operators prefer failed writes over eviction.
REDIS_MEM_LIMIT=2g
REDIS_MAXMEMORY=1536mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ── RabbitMQ ─────────────────────────────────────
RABBITMQ_USER=tim
RABBITMQ_PASSWORD=REPLACE_WITH_PASSWORD

# ── MinIO ────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=REPLACE_WITH_PASSWORD

# Shared HTTP basic-auth login for SOC Dashboard and Kibana.
KIBANA_USER=analyst
KIBANA_PASSWORD=REPLACE_WITH_PASSWORD

# ── Conectores OpenCTI ───────────────────────────
CONNECTOR_MITRE_ID=REPLACE_WITH_UUID
# Maximum seconds bootstrap-platform waits for the full ATT&CK relationship graph.
MITRE_IMPORT_TIMEOUT=5400
# Maximum seconds Compose waits for every full-stack healthcheck after MITRE.
TIM_STARTUP_TIMEOUT=600
CONNECTOR_IPINFO_ID=REPLACE_WITH_UUID
CONNECTOR_CVE_ID=REPLACE_WITH_UUID
CONNECTOR_CISA_KEV_ID=REPLACE_WITH_UUID
CONNECTOR_MISP_FEED_ID=REPLACE_WITH_UUID
CONNECTOR_GREYNOISE_FEED_ID=REPLACE_WITH_UUID

# ── IpInfo GeoIP (free account — https://ipinfo.io/signup) ──
IPINFO_TOKEN=             # optional — enriches IP observables with GeoIP data

# ── NVD CVE API key (optional — https://nvd.nist.gov/developers/request-an-api-key) ──
CVE_NVD_API_KEY=       # optional — higher rate limits for CVE sync

# ── Feed API Keys (all optional — feeds are disabled if key is absent) ──
OTX_API_KEY=              # optional — AlienVault OTX feed (free account at otx.alienvault.com)
MALWAREBAZAAR_AUTH_KEY=   # optional — MalwareBazaar feed (free account at abuse.ch)
THREATFOX_AUTH_KEY=       # optional — ThreatFox feed (free account at abuse.ch)
ABUSECH_AUTH_KEY=         # optional — SSLBL Auth-Key header; SSLBL static feeds also work keyless
GREYNOISE_API_KEY=        # GreyNoise Feed API key (account at viz.greynoise.io) — used by connector-greynoise-feed
